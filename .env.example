# Supabase — proiectul brnweurjdimvwydoiafd
NUXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable/anon key: Supabase Dashboard → Project Settings → API
NUXT_PUBLIC_SUPABASE_KEY=
# Secret (service_role) — doar local; la deploy cu `wrangler secret put`
SUPABASE_SECRET_KEY=

# Login cu Google: true doar după ce providerul e configurat în Supabase → Authentication → Providers
NUXT_PUBLIC_AUTH_GOOGLE=false
